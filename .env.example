# DataExtractor_Noora Configuration
# Copy to .env and fill in your values

# --- Model Selection ---
# Options: "local" (Ollama/qwen2.5-vl:3b) or "cloud"
VISION_MODE=local

# --- Local Model ---
OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_HOST=http://localhost:11434

# --- Cloud API Keys (required if VISION_MODE=cloud) ---
ANTHROPIC_API_KEY=
# Preferred cloud model: claude-3-5-sonnet-20241022
CLAUDE_MODEL=claude-3-5-sonnet-20241022

GOOGLE_API_KEY=
# Preferred cloud model: gemini-2.5-pro-exp-03-25
GEMINI_MODEL=gemini-2.5-pro-exp-03-25

# --- OpenCode Go (Muse Spark access) ---
# 1. Sign in to OpenCode Zen, subscribe to Go, and copy your API key
#    (same key you paste into the opencode agent via /connect -> OpenCode Go)
# 2. Paste it below. Full model list: https://opencode.ai/zen/go/v1/models
OPENCODE_API_KEY=
# (alias also accepted: OPENCODE_GO_API_KEY)
# Base URL of the OpenCode Go API (documented default; rarely needs changing)
OPENCODE_API_BASE=https://opencode.ai/zen/go/v1
# Muse Spark model ID (vision-capable). Default is the Contributor build
# that ships with the official opencode agent.
OPENCODE_MODEL=muse-spark-1.3-contributor

# --- Cloud Provider Selection (when VISION_MODE=cloud) ---
# Options: "anthropic", "gemini", or "muse"
CLOUD_PROVIDER=anthropic

# --- Extraction Settings ---
# Default correlation coefficient for SD change imputation
DEFAULT_CORR=0.5

# Output directories
OUTPUT_DIR=./output
MARKDOWN_DIR=./output/markdown
IMAGES_DIR=./output/extracted_images
RESULTS_DIR=./output/results

# --- OCR ---
# Tesseract path (auto-detected on most systems, set if needed)
TESSERACT_CMD=tesseract

# --- Template Export ---
# Optional: default template path for extraction sheet mapping
TEMPLATE_PATH=
